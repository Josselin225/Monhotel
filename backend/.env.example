# Copier ce fichier en .env et remplir les valeurs
# Générer une SECRET_KEY :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-OBLIGATOIRE
DEBUG=False
ALLOWED_HOSTS=mon-hotel-api.railway.app,localhost

# ── Base de données (PostgreSQL en production) ────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── CORS (URL du frontend) ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://mon-hotel.vercel.app,http://localhost:5173

# ── HTTPS ─────────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
# Domaines derrière le proxy HTTPS autorisés à faire des requêtes POST/PUT
# avec cookie de session (nécessaire pour /admin/) :
CSRF_TRUSTED_ORIGINS=https://mon-hotel-api.railway.app

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Mon Hôtel <no-reply@monhotel.ci>

# ── Hôtel ─────────────────────────────────────────────────────────────────────
HOTEL_NAME=Mon Hôtel
STAFF_ALERT_EMAILS=admin@monhotel.ci

# ── Enquêtes de satisfaction ──────────────────────────────────────────────────
SURVEY_REMINDER_DAYS=3

# ── Cache Redis (optionnel, sinon mémoire locale) ─────────────────────────────
# CACHE_URL=redis://localhost:6379/0

# ── WebSocket (optionnel, sinon InMemoryChannelLayer) ─────────────────────────
# CHANNEL_LAYERS_BACKEND=redis
# REDIS_URL=redis://localhost:6379
