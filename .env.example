# ── Obligatoire ──────────────────────────────────────────────────────────────
SECRET_KEY=changez-moi-en-production-minimum-50-caracteres-aleatoires
DB_PASSWORD=motdepasse-postgres-securise

# ── Base de données ───────────────────────────────────────────────────────────
DB_NAME=monhotel
DB_USER=monhotel
# DATABASE_URL est construit automatiquement dans docker-compose.yml

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com
CORS_ALLOWED_ORIGINS=https://votre-domaine.com

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=https://votre-domaine.com/api

# ── Email (Gmail) ─────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-app-password-gmail
DEFAULT_FROM_EMAIL=Mon Hôtel <no-reply@votre-domaine.com>

# ── Notifications internes ────────────────────────────────────────────────────
HOTEL_NAME=Mon Hôtel
STAFF_ALERT_EMAILS=reception@monhotel.ci,manager@monhotel.ci
SURVEY_REMINDER_DAYS=3

# ── WebSocket (Redis en production) ───────────────────────────────────────────
CHANNEL_LAYERS_BACKEND=redis
REDIS_URL=redis://redis:6379

# ── URL publique du frontend (pour les liens dans les emails) ─────────────────
FRONTEND_URL=https://votre-domaine.com

# ── Sécurité HTTPS ────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
